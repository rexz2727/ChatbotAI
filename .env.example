GEMINI_API_KEY=your_gemini_api_key_here
ZALO_ACCESS_TOKEN=your_zalo_access_token_here
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token_here
FB_VERIFY_TOKEN=cong_an_phuong_verify_token_123

# Server Configuration
# HOST=127.0.0.1  # safe default for local dev (node index.js)
# HOST=0.0.0.0   # required inside Docker (pinned by compose environment block)
HOST=127.0.0.1
PORT=3000
# CHATBOT_BIND_IP: controls the host-side IP Docker binds the chatbot port to (default: loopback only)
CHATBOT_BIND_IP=127.0.0.1

# ChromaDB Configuration
# CHROMA_HOST is overridden to 'chromadb' (Docker service name) by docker-compose.yml
# Use 'localhost' only when running outside Docker (node index.js directly)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_BIND_IP=127.0.0.1

# SQLITE_DB_PATH=./data/database.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Facebook Security Verification
FB_APP_SECRET=your_fb_app_secret_here

# PII Masking in Logs
MASK_PII_LOGS=true

# Threat Intelligence (Task 6)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
