GEMINI_API_KEY=your_gemini_api_key_here
ZALO_ACCESS_TOKEN=your_zalo_access_token_here
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token_here
FB_VERIFY_TOKEN=cong_an_phuong_verify_token_123

# Server Configuration
# HOST=127.0.0.1  # safe default for local dev (node index.js)
# HOST=0.0.0.0   # required inside Docker (pinned by compose environment block)
HOST=127.0.0.1
PORT=3000
# CHATBOT_BIND_IP: controls the host-side IP Docker binds the chatbot port to (default: loopback only)
CHATBOT_BIND_IP=127.0.0.1

# ChromaDB Configuration
# CHROMA_HOST is overridden to 'chromadb' (Docker service name) by docker-compose.yml
# Use 'localhost' only when running outside Docker (node index.js directly)
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_BIND_IP=127.0.0.1

# SQLITE_DB_PATH=./data/database.db

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Facebook Security Verification
FB_APP_SECRET=your_fb_app_secret_here

# PII Masking in Logs
MASK_PII_LOGS=true

# Threat Intelligence (Task 6)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# Max kích thước tệp đính kèm được tải để quét (byte). Mặc định 25MB.
MAX_ATTACHMENT_SIZE=26214400
# Đặt 'true' để gửi tệp lạ (VirusTotal chưa từng thấy) lên VT phân tích.
# MẶC ĐỊNH TẮT — tránh gửi tài liệu của người dân cho bên thứ ba (riêng tư).
VT_UPLOAD_UNKNOWN=false

# Web Admin Authentication (port 3001)
ADMIN_USER=admin
# Sinh hash: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync(process.argv[1],s,32).toString('hex'))" 'MAT_KHAU_CUA_BAN'
ADMIN_PASSWORD_HASH=your_salt:your_scrypt_hash_here
SESSION_SECRET=doi_chuoi_nay_thanh_chuoi_ngau_nhien_dai
